# Gemini API 키 설정 (Google AI Studio에서 발급받은 키를 입력하세요)
GEMINI_API_KEY="your_gemini_api_key_here"

# 옵시디언 템플릿 노트가 저장될 폴더의 절대 경로를 입력하세요
# (주의: 경로에 백슬래시(\)가 포함된 윈도우 경로의 경우 따옴표로 감싸주세요)
OBSIDIAN_FOLDER_PATH="C:\Users\username\Documents\Obsidian\Music"

# 사용할 모델을 순위별로 쉼표(,)로 구분해서 작성 (예: gemini-3.5-flash-lite, gemini-3.1-flash-lite, gemini-2.5-flash, gemini-1.5-flash 등)
GEMINI_FALLBACK_MODELS="gemini-3.5-flash-lite, gemini-3.1-flash-lite"